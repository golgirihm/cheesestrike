# The versions CI tests with. CI loads this file, and tools/run_tests.py warns
# when a local run uses something else.
#
# These are changed by hand. Godot's hash has to change with its version: it is
# the SHA-256 of the Linux x86_64 zip, shown on the release's page on GitHub.
# The websockets version lives in signaling/requirements.txt instead, where
# Dependabot updates it.
PYTHON_VERSION=3.14.7
GODOT_VERSION=4.7.2
GODOT_SHA256=cadd3204e728a35d3f13adb7fd0d7902636b79f6b95c40c265eb73b6c35329e4

# The versions CI tests with. CI loads this file, and tools/run_tests.py warns
# when a local run uses something else.
#
# These are changed by hand. Godot's hash has to change with its version: it is
# the SHA-256 of the Linux x86_64 zip, shown on the release's page on GitHub.
# So does the Web template's hash: it is the SHA-256 of web_nothreads_debug.zip
# from that version's export templates, which the browser tests export with.
# webrtc-native, which gives native builds WebRTC (tools/fetch_webrtc.py),
# is pinned by its release and the SHA-256 of godot-extension-webrtc_native.zip,
# which GitHub shows beside the file on the release's page.
# The websockets version lives in signaling/requirements.txt instead, where
# Dependabot updates it.
PYTHON_VERSION=3.14.7
GODOT_VERSION=4.7.2
GODOT_SHA256=cadd3204e728a35d3f13adb7fd0d7902636b79f6b95c40c265eb73b6c35329e4
GODOT_WEB_TEMPLATE_SHA256=08962aefef811b603541d7951ac67ef00413aad2d978855183c28adee98f626a
WEBRTC_NATIVE_VERSION=1.2.2
WEBRTC_NATIVE_SHA256=98e9446921740d995bd9ca1be48798dc3c2ceed51e044a25ce18b3cff11f56e5
